{
  "name": "solrift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @solrift/server\" \"npm run dev -w @solrift/web\"",
    "dev:web": "npm run dev -w @solrift/web",
    "dev:server": "npm run dev -w @solrift/server",
    "build": "npm run build -w @solrift/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "test:e2e": "node scripts/e2e.mjs",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "playwright": "^1.65.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
