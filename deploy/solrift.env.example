# The game server's settings. Copy to /etc/solrift.env on the droplet (chmod 600) and edit.
# The page is on https://play.solrift.io (Vercel), the server on https://api.solrift.io (this droplet).

# Where the server listens (Caddy forwards to it; the firewall keeps this port closed to the outside).
PORT=8787

# The browser addresses that may sign in and use cloud saves: EXACTLY the address of the page, comma-separated, no trailing slash.
AUTH_ORIGINS=https://play.solrift.io

# The page and the server are on sibling names of one domain: share the sign-in cookie between them (the cookie is set through
# the page's /api, and the game socket at api.solrift.io has to see it too). Use the domain both names end with.
COOKIE_DOMAIN=solrift.io
COOKIE_SECURE=1
# Caddy sets X-Forwarded-For: believe it (the connection limits are per address).
TRUST_PROXY=1

# Where the world, the accounts and the characters are kept (a folder the service may write to; back it up).
DATABASE_PATH=/var/lib/solrift/solrift.db

# Optional
# MAX_PLAYERS=120
# GAME_MODE=survival
# NO_MOBS=1
# CHEATS=1            # only on a private server
# WORLD_KIND=overworld
