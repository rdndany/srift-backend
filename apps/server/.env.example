# Copy to .env (git-ignored) and fill in. Real environment variables override anything here.

# The $SOLRIFT token. Leave TOKEN_MINT empty to keep it off. See docs/TOKEN.md.
TOKEN_MINT=
# devnet | testnet | mainnet-beta (required when TOKEN_MINT is set)
SOLANA_CLUSTER=
# Path to the Solana keypair file that holds the tokens to pay out. Keep it OUTSIDE the repo. Empty = withdrawals closed.
TREASURY_KEYPAIR=
# Optional: your own RPC endpoint (the public one is rate limited)
# SOLANA_RPC_URL=
